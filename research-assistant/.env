# GitHub Models Configuration
# Store your Personal Access Token in repository secrets as `GITHUB_PAT`
# or set it in your local environment. Do NOT commit real tokens to the repo.
GITHUB_PAT=GITHUB_PAT_PLACEHOLDER

# Model selection - choose from available GitHub models
# Examples: openai/gpt-4o, openai/gpt-4o-mini, meta/llama-3.1-8b-instruct
MODEL_ID=openai/gpt-4o-mini
