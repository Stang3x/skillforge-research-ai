# Research Assistant Environment Variables
# Copy this file to .env and fill in your API keys
#
# Usage:
#   cp .env.example .env
#   # Edit .env with your keys
#   docker-compose up

# ═══════════════════════════════════════════════════════════════
# REQUIRED
# ═══════════════════════════════════════════════════════════════

# Anthropic API Key (required)
# Get yours at: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api03-YOUR-KEY-HERE

# ═══════════════════════════════════════════════════════════════
# OPTIONAL - API Keys for Higher Rate Limits
# ═══════════════════════════════════════════════════════════════

# Semantic Scholar API Key (optional, recommended)
# Get a free key at: https://www.semanticscholar.org/product/api#api-key-form
# Benefits: Higher rate limits (100 req/sec vs 100 req/5min)
SEMANTIC_SCHOLAR_API_KEY=

# GitHub Personal Access Token (optional)
# Get one at: https://github.com/settings/tokens
# Benefits: Higher rate limits for GitHub API
# GITHUB_TOKEN=

# ═══════════════════════════════════════════════════════════════
# OPTIONAL - Local Directory Mounts
# ═══════════════════════════════════════════════════════════════

# Local directory for PDFs (mounted read-only)
# Example: LOCAL_PDF_DIR=./my-papers
LOCAL_PDF_DIR=./pdfs

# Local directory for exports (mounted read-write)
# Example: LOCAL_EXPORT_DIR=./my-exports
LOCAL_EXPORT_DIR=./exports

# ═══════════════════════════════════════════════════════════════
# ADVANCED - Container Settings
# ═══════════════════════════════════════════════════════════════

# Data directory inside container (usually don't change)
# RESEARCH_DATA_DIR=/app/data
